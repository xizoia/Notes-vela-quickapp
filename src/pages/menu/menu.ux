<template>
  <div class="container">
    <!-- 顶部栏：和主页一致 -->
    <div class="header">
      <text class="title">菜单</text>
      <text if="{{screenShape == 'rect'}}" class="title" @click="goBack">{{NowTime}}</text>
    </div>

    <!-- 菜单列表：卡片风格，和主页笔记列表一致 -->
    <div class="full-area center">
      <scroll scroll-y="true" bounces="true" class="{{scrclass}} full-area center" style="color: white;margin-top: 6px;">
        <!-- 查看完整标题 -->
        <div if="{{fullTitle}}" class="menu-card menu-card-title" @click="onViewTitle">
          <text class="menu-icon">≡</text>
          <text class="menu-card-text">查看完整标题</text>
        </div>
        <div class="menu-card" @click="onSave">
          <text class="menu-icon">✓</text>
          <text class="menu-card-text">保存笔记</text>
        </div>
        <div class="menu-card menu-card-exit" @click="onExit">
          <text class="menu-icon-exit">✕</text>
          <text class="menu-card-text-exit">退出编辑</text>
        </div>
        <div class="menu-card" @click="goBack">
          <text class="menu-icon-back">‹</text>
          <text class="menu-card-text">返回编辑</text>
        </div>
        <div class="bottomzw"></div>
      </scroll>
    </div>

    <!-- 标题详情弹窗 -->
    <div if="{{showTitleView}}" class="title-mask" @click="closeTitleView">
      <div class="title-panel" @click="onPanelClick">
        <text class="title-view-label">完整标题</text>
        <text class="title-view-text">{{fullTitle}}</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'

export default {
  protected: {
    action: null
  },
  private: {
    NowTime: '--:--',
    scrclass: '',
    screenShape: 'rect',
    showTitleView: false,
    fullTitle: '',
  },

  onInit() {
    global.uiAdm.registerPage(this.$page.name, this)
    this.screenShape = (global.Screen && global.Screen.screenShape) || 'rect'
    const h = global.NowHour || '--'
    const m = global.NowMin || '--'
    this.NowTime = h + ':' + m
    this.fullTitle = global.menuFullTitle || ''
  },

  onViewTitle() {
    this.showTitleView = true
  },

  closeTitleView() {
    this.showTitleView = false
  },

  onPanelClick() {
    // 阻止冒泡
  },

  // 保存：直接在菜单页执行保存，然后返回主页
  async onSave() {
    const editPage = global.pagePool.get('edit')
    if (!editPage) return
    const title = editPage.textParts.title.join('')
    const content = editPage.textParts.content.join('')
    if (!title.trim() && !content.trim()) {
      global.uiAdm.MessageBox('内容为空，未保存')
      router.back()
      return
    }
    try {
      await global.notesStore.saveNote({
        id: editPage.noteId,
        title: title,
        content: content
      })
      global.uiAdm.MessageBox(editPage.isEdit ? '已保存' : '已创建')
      editPage.showKeyboard = false
      // 连续返回两次：编辑页→主页
      router.back()
      setTimeout(() => router.back(), 200)
    } catch (e) {
      console.log('[笔记] 保存失败:', e)
      global.uiAdm.MessageBox('保存失败')
    }
  },

  // 退出：不保存直接返回主页
  onExit() {
    const editPage = global.pagePool.get('edit')
    if (editPage) editPage.showKeyboard = false
    // 连续返回两次：编辑页→主页
    router.back()
    setTimeout(() => router.back(), 200)
  },

  goBack() {
    this.back()
  },

  onBackPress() { this.back(); return true },
  onDestroy() { global.uiAdm.unregisterPage(this.$page.name) }
}
</script>

<style>
@import '../../common/css/loading.css';

.header {
  width: 100%;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 12px 18px;
}
.title {
  font-size: 28px;
  color: #ffffff;
}
.menu-card {
  width: 90%;
  flex-direction: row;
  align-items: center;
  background-color: #2a2a2a;
  border-radius: 20px;
  padding: 16px;
  margin-top: 10px;
}
.menu-card-exit {
  background-color: rgba(255, 77, 79, 0.15);
}
.menu-icon {
  font-size: 30px;
  color: #0c84ff;
  margin-right: 12px;
}
.menu-icon-exit {
  font-size: 30px;
  color: #ff6a6a;
  margin-right: 12px;
}
.menu-icon-back {
  font-size: 34px;
  color: #0c84ff;
  margin-right: 12px;
}
.menu-card-text {
  font-size: 28px;
  color: #ffffff;
  font-weight: bold;
}
.menu-card-text-exit {
  font-size: 28px;
  color: #ff6a6a;
  font-weight: bold;
}
@media screen and (shape: circle) {
  .menu-card {
    width: 80%;
  }
}
.menu-card-title {
  background-color: rgba(12, 132, 255, 0.12);
}
.title-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.7);
  align-items: center;
  justify-content: center;
}
.title-panel {
  width: 90%;
  background-color: #2a2a2a;
  border-radius: 20px;
  padding: 20px;
}
.title-view-label {
  font-size: 20px;
  color: #6a6a6a;
  margin-bottom: 10px;
}
.title-view-text {
  font-size: 28px;
  color: #ffffff;
  font-weight: bold;
}
</style>
