  height: 24px;
}
.time {
  width: 20px;
  height: 34px;
  font-size: 30px;
  text-align: center;
  color: #e2e2e2;
  transform-origin: 10px 17px;
}
.fd {
  flex-direction: column;
}
.fr {
  flex-direction: row;
}
.wd100 {
  width: 100%;
}
.jcsb {
  justify-content: space-between;
}
/* 顶部栏：默认(方屏) 左右布局 */
.header {
  width: 100%;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 12px 20px;
}
.bottomzw {
  height: 50px;
}
@media screen and (shape: circle) {
  .header {
    flex-direction: column;
    padding: 24px 20px 6px;
  }
}
@media screen and (shape: rect) {
  .header {
    padding: 18px 52px 16px;
  }
}
