<script>
import * as uiAdm from './common/js/uiAdm'
import { getDeviceInfo } from './common/js/useful.js'
import * as notesStore from './common/js/notesStore.js'

export default {
  timeUpdateTimer: null,

  async onCreate() {
    // 将常用模块挂载到 global，页面中通过 global.xxx 访问
    global.uiAdm = uiAdm
    global.notesStore = notesStore

    uiAdm.initAdm()
    // 页面过渡动画开关，默认关闭
    global.AdmSet = 0

    // 同步初始化全局变量默认值，避免页面 onInit 执行时出现 undefined
    const now0 = new Date()
    global.NowHour = now0.getHours().toString().padStart(2, '0')
    global.NowMin = now0.getMinutes().toString().padStart(2, '0')
    global.Screen = global.Screen || {
      screenWidth: 0,
      screenHeight: 0,
      screenShape: 'rect'
    }
    uiAdm.UpdateTime(global.NowHour + ':' + global.NowMin)

    await getDeviceInfo()
    await notesStore.init()

    this.updateTime()
    this.timeUpdateTimer = setInterval(() => this.updateTime(), 1000)
  },

  updateTime() {
    const now = new Date()
    global.NowHour = now.getHours().toString().padStart(2, '0')
    global.NowMin = now.getMinutes().toString().padStart(2, '0')
    uiAdm.UpdateTime(global.NowHour + ':' + global.NowMin)
  },

  onDestroy() {
    clearInterval(this.timeUpdateTimer)
  }
}
</script>
